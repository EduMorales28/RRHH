<Window x:Class="Barraca.RRHH.App.Windows.NuevoMesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo mes" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <StackPanel Margin="18">
        <TextBlock Text="Crear un mes nuevo" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
        <TextBlock Margin="0,6,0,14" TextWrapping="Wrap" Foreground="#334155"
                   Text="Se copian las filas del mes elegido (funcionarios, tipo de obra, obras y observaciones) con montos y horas en blanco. Después solo hay que completar los números y agregar o quitar filas."/>

        <TextBlock Text="Período nuevo (AAAA-MM)" FontWeight="SemiBold"/>
        <TextBox x:Name="txtPeriodo" Margin="0,4,0,12" Padding="6" FontSize="14"/>

        <TextBlock Text="Copiar las filas de" FontWeight="SemiBold"/>
        <ComboBox x:Name="cmbOrigen" Margin="0,4,0,18" Padding="6" FontSize="14"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Padding="14,8" Margin="0,0,8,0" IsCancel="True" Click="Cancelar_Click"/>
            <Button Content="Crear mes" Padding="14,8" IsDefault="True" Click="Crear_Click"
                    Background="#0F766E" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </StackPanel>
</Window>
