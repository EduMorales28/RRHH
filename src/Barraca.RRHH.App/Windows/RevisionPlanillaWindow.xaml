<Window x:Class="Barraca.RRHH.App.Windows.RevisionPlanillaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revisión de planilla" Height="600" Width="1200"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F8FAFC">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" Padding="12" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="txtTitulo" FontWeight="Bold" FontSize="18" Foreground="#0F172A"/>
                <TextBlock x:Name="txtSubtitulo" Margin="0,4,0,0" Foreground="#334155" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1" x:Name="dgProblemas" Margin="0,12,0,12" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                  SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EsError}" Value="True">
                            <Setter Property="Background" Value="#FEE2E2"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding EsError}" Value="False">
                            <Setter Property="Background" Value="#FEF9C3"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Severidad}" Width="70"/>
                <DataGridTextColumn Header="Fila Excel" Binding="{Binding Fila}" Width="80"/>
                <DataGridTextColumn Header="Funcionario / Obra" Binding="{Binding Funcionario}" Width="250"/>
                <DataGridTextColumn Header="Problema" Binding="{Binding Problema}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Qué hacer" Binding="{Binding Sugerencia}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2">
            <Button Content="Copiar lista" Padding="14,8" Click="Copiar_Click"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar (corregir la planilla)" Padding="14,8" Click="Cancelar_Click" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="btnImportar" Content="Importar igual" Padding="14,8" Click="Importar_Click" Background="#0F766E" Foreground="White" FontWeight="SemiBold"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
