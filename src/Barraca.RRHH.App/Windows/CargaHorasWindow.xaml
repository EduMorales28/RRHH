<Window x:Class="Barraca.RRHH.App.Windows.CargaHorasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Barraca.RRHH.App.Helpers"
        Title="Cargar horas del mes" Height="760" Width="1300"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#F8FAFC">
    <Window.Resources>
        <helpers:NumeroConverter x:Key="Numero"/>
        <Style x:Key="Num" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style x:Key="Calc" TargetType="DataGridCell">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style x:Key="FilaRevisar" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RequiereRevision}" Value="True">
                    <Setter Property="Background" Value="#FEF9C3"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TieneError}" Value="True">
                    <Setter Property="Background" Value="#FEE2E2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Tabla" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeaderWidth" Value="12"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" Padding="12" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1">
            <StackPanel>
                <TextBlock FontWeight="Bold" FontSize="18" Foreground="#0F172A">
                    <Run Text="Archivo de horas → Horas del mes"/>
                    <Run Text="{Binding Periodo, Mode=OneWay, StringFormat='({0})'}"/>
                </TextBlock>
                <TextBlock Text="{Binding ResumenArchivo}" Margin="0,6,0,0" Foreground="#334155" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Resumen}" Margin="0,4,0,0" Foreground="#334155" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Margin="0,6,0,0" Foreground="#334155" TextWrapping="Wrap"
                           Text="Las horas de cada persona van al número del programa que cobra en ese tipo de obra. Revise las filas amarillas (puede escribir otro número). Las horas del mes en pantalla se reemplazan por las del archivo; queda sin guardar hasta que apriete 'Guardar horas'."/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="0,10,0,0">
            <TabItem Header="{Binding TituloPersonas}">
                <DockPanel Margin="6">
                    <CheckBox DockPanel.Dock="Top" Content="Ver solo los funcionarios para revisar" IsChecked="{Binding SoloARevisar}"/>
                    <DataGrid x:Name="dgPersonas" Style="{StaticResource Tabla}" RowStyle="{StaticResource FilaRevisar}" ItemsSource="{Binding VistaPersonas}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo, Mode=OneWay}" Width="150" IsReadOnly="True" CellStyle="{StaticResource Calc}"/>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo, Mode=OneWay}" Width="70" IsReadOnly="True" CellStyle="{StaticResource Calc}"/>
                            <DataGridTextColumn Header="En el archivo de horas" Binding="{Binding Nombre, Mode=OneWay}" Width="270" IsReadOnly="True" CellStyle="{StaticResource Calc}"/>
                            <DataGridTextColumn Header="Hs. equiv." Binding="{Binding Horas, Mode=OneWay, Converter={StaticResource Numero}}" Width="80" IsReadOnly="True" ElementStyle="{StaticResource Num}" CellStyle="{StaticResource Calc}"/>
                            <DataGridTextColumn Header="N° func. programa" Binding="{Binding NumeroFuncionario, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                            <DataGridTextColumn Header="Funcionario en el programa" Binding="{Binding NombrePrograma, Mode=OneWay}" Width="250" IsReadOnly="True" CellStyle="{StaticResource Calc}"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado, Mode=OneWay}" Width="*" MinWidth="200" IsReadOnly="True" CellStyle="{StaticResource Calc}"/>
                            <DataGridTextColumn Header="Problema" Binding="{Binding Problema, Mode=OneWay}" Width="200" IsReadOnly="True" CellStyle="{StaticResource Calc}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="{Binding TituloObras}">
                <DataGrid x:Name="dgObras" Style="{StaticResource Tabla}" RowStyle="{StaticResource FilaRevisar}" ItemsSource="{Binding Obras}" Margin="6">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo, Mode=OneWay}" Width="150" IsReadOnly="True" CellStyle="{StaticResource Calc}"/>
                        <DataGridTextColumn Header="Obra en el archivo" Binding="{Binding Nombre, Mode=OneWay}" Width="230" IsReadOnly="True" CellStyle="{StaticResource Calc}"/>
                        <DataGridTextColumn Header="Hs. equiv." Binding="{Binding Horas, Mode=OneWay, Converter={StaticResource Numero}}" Width="80" IsReadOnly="True" ElementStyle="{StaticResource Num}" CellStyle="{StaticResource Calc}"/>
                        <DataGridTextColumn Header="N° obra programa" Binding="{Binding NumeroObra, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                        <DataGridCheckBoxColumn Header="Crear" Binding="{Binding CrearNueva, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                        <DataGridTextColumn Header="Obra en el programa" Binding="{Binding NombrePrograma, Mode=OneWay}" Width="290" IsReadOnly="True" CellStyle="{StaticResource Calc}"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado, Mode=OneWay}" Width="*" MinWidth="180" IsReadOnly="True" CellStyle="{StaticResource Calc}"/>
                        <DataGridTextColumn Header="Problema" Binding="{Binding Problema, Mode=OneWay}" Width="220" IsReadOnly="True" CellStyle="{StaticResource Calc}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{Binding TituloSede}">
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#334155"
                               Text="Cobran en el mes y no tienen horas de ese tipo: se les carga 1 hora. Industria y Comercio (administrativos): SEDE de oficina. Metalúrgica: obra METALURGICA. Administración: Sede A. Construcción y N-A: solo a quien tiene marcado '1 h SEDE' en Funcionarios. Los pagos de Metalúrgica, Administración y N-A se cargan a mano antes de cargar las horas."/>
                    <DataGrid Style="{StaticResource Tabla}" ItemsSource="{Binding HorasSede}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N° func." Binding="{Binding NumeroFuncionario}" Width="80"/>
                            <DataGridTextColumn Header="Funcionario" Binding="{Binding Nombre}" Width="280"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="160"/>
                            <DataGridTextColumn Header="Obra" Binding="{Binding NumeroObra}" Width="70"/>
                            <DataGridTextColumn Header="Nombre obra" Binding="{Binding NombreObra}" Width="200"/>
                            <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="{Binding TituloTickets}">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Text="Valor de un ticket:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding ValorTicket, Converter={StaticResource Numero}, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Width="100" Padding="4" TextAlignment="Right"/>
                        <TextBlock Text="{Binding ResumenTickets}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#334155"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#334155"
                               Text="Columna 'Tck Alimentacion' del archivo. En Pagos del mes, el Líquido de la fila TICKET de cada uno pasa a ser tickets × valor (si no tiene fila TICKET se agrega). Las filas TICKET de quien no tiene tickets este mes quedan en 0."/>
                    <DataGrid Style="{StaticResource Tabla}" ItemsSource="{Binding Tickets}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N° func." Binding="{Binding NumeroFuncionario}" Width="80"/>
                            <DataGridTextColumn Header="Funcionario" Binding="{Binding Nombre}" Width="300"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="170"/>
                            <DataGridTextColumn Header="Tickets" Binding="{Binding Cantidad, Converter={StaticResource Numero}}" Width="80" ElementStyle="{StaticResource Num}"/>
                            <DataGridTextColumn Header="Importe (Líquido TICKET)" Binding="{Binding Importe, Converter={StaticResource Numero}}" Width="170" ElementStyle="{StaticResource Num}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="{Binding TituloSinHoras}">
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#7F1D1D"
                               Text="Cobran en el mes y quedan sin horas de ese tipo: su costo no se puede repartir entre obras. Revise si falta en el archivo, si sus horas están con otro número, o márquelo '1 h SEDE' en Funcionarios."/>
                    <ListBox ItemsSource="{Binding SiguenSinHoras}" Margin="0,8,0,0" FontSize="13"/>
                </DockPanel>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock VerticalAlignment="Center" Foreground="#475569" TextWrapping="Wrap" MaxWidth="760"
                       Text="Al cargar se crean las obras nuevas y se recuerdan los códigos y obras elegidos para los próximos meses."/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Padding="14,8" Margin="0,0,8,0" IsCancel="True" Click="Cancelar_Click"/>
                <Button Content="Cargar en Horas del mes" Padding="14,8" Click="Cargar_Click"
                        Background="#0F766E" Foreground="White" FontWeight="SemiBold"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
