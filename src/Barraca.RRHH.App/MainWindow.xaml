<Window x:Class="Barraca.RRHH.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:carga="clr-namespace:Barraca.RRHH.App.ViewModels.Carga"
        xmlns:helpers="clr-namespace:Barraca.RRHH.App.Helpers"
        Title="Sueldos Almirtaun" Height="900" Width="1500" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <helpers:NumeroConverter x:Key="Numero"/>
        <BooleanToVisibilityConverter x:Key="BoolAVisible"/>

        <Style x:Key="CeldaNumero" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style x:Key="CeldaCalculada" TargetType="DataGridCell">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style x:Key="CeldaProblema" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#7F1D1D"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style x:Key="FilaCarga" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding TieneAviso}" Value="True">
                    <Setter Property="Background" Value="#FEF9C3"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TieneError}" Value="True">
                    <Setter Property="Background" Value="#FEE2E2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Modificada}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TablaCarga" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowStyle" Value="{StaticResource FilaCarga}"/>
            <Setter Property="RowHeaderWidth" Value="18"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowHeight" Value="26"/>
        </Style>
        <Style x:Key="BotonPrincipal" TargetType="Button">
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style x:Key="BotonBarra" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#16324F" Padding="14">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Border Background="White" CornerRadius="6" Padding="6,4" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Image Source="Assets/logo-morales.png" Height="46" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Sueldos Almirtaun" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <Border Background="#0F766E" CornerRadius="6" Padding="10,4" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EstadoPeriodoTexto}" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="➕ Nuevo mes" Command="{Binding NuevoMesCommand}" Height="32" VerticalAlignment="Center" Padding="14,4" FontWeight="SemiBold" Margin="0,0,16,0"
                            Background="#0F766E" Foreground="White"/>
                    <TextBlock Text="Ver período:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="120" Height="32" VerticalAlignment="Center" ItemsSource="{Binding PeriodosDisponibles}"
                              Text="{Binding Periodo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" Margin="0,0,8,0" VerticalContentAlignment="Center" FontSize="14"/>
                    <Button Content="Ir" Command="{Binding CambiarPeriodoCommand}" Height="32" VerticalAlignment="Center" Padding="14,4" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <Button Content="&#x21BB; Refrescar" Command="{Binding RefrescarDashboardCommand}" Height="32" VerticalAlignment="Center" Padding="12,4"/>
                    <Button Content="✕ Cerrar" Height="32" VerticalAlignment="Center" Padding="12,4" Margin="12,0,0,0"
                            Click="CerrarApp_Click" Foreground="White" Background="#6B7280" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="12" FontSize="13">
            <!-- ============================================================ INICIO -->
            <TabItem Header="Inicio">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <UniformGrid Columns="4">
                            <Border Background="White" CornerRadius="10" Margin="8" Padding="16"><StackPanel><TextBlock Text="Período" Foreground="#6B7280"/><TextBlock Text="{Binding Dashboard.Periodo}" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
                            <Border Background="White" CornerRadius="10" Margin="8" Padding="16"><StackPanel><TextBlock Text="Total generado" Foreground="#6B7280"/><TextBlock Text="{Binding Dashboard.TotalGenerado, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
                            <Border Background="White" CornerRadius="10" Margin="8" Padding="16"><StackPanel><TextBlock Text="Adelantos" Foreground="#6B7280"/><TextBlock Text="{Binding Dashboard.Adelantos, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
                            <Border Background="White" CornerRadius="10" Margin="8" Padding="16"><StackPanel><TextBlock Text="Líquidos" Foreground="#6B7280"/><TextBlock Text="{Binding Dashboard.Liquidos, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
                        </UniformGrid>
                        <UniformGrid Columns="4">
                            <Border Background="White" CornerRadius="10" Margin="8" Padding="16"><StackPanel><TextBlock Text="Retenciones" Foreground="#6B7280"/><TextBlock Text="{Binding Dashboard.Retenciones, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
                            <Border Background="White" CornerRadius="10" Margin="8" Padding="16"><StackPanel><TextBlock Text="Funcionarios activos" Foreground="#6B7280"/><TextBlock Text="{Binding Dashboard.FuncionariosActivos}" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
                            <Border Background="White" CornerRadius="10" Margin="8" Padding="16"><StackPanel><TextBlock Text="Obras activas" Foreground="#6B7280"/><TextBlock Text="{Binding Dashboard.ObrasActivas}" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
                            <Border Background="White" CornerRadius="10" Margin="8" Padding="16"><StackPanel><TextBlock Text="Líneas distribuidas" Foreground="#6B7280"/><TextBlock Text="{Binding Dashboard.LineasDistribuidas}" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
                        </UniformGrid>

                        <Border Background="White" CornerRadius="10" Margin="8" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Cómo hacer los sueldos del mes" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"><Run FontWeight="Bold" Text="1. Nuevo mes: "/><Run Text="botón '➕ Nuevo mes' arriba. Copia las filas del mes anterior con montos y horas en blanco."/></TextBlock>
                                <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"><Run FontWeight="Bold" Text="2. Funcionarios y Obras: "/><Run Text="si entró alguien nuevo o hay una obra nueva, agréguelos en sus pestañas y guarde."/></TextBlock>
                                <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"><Run FontWeight="Bold" Text="3. Pagos del mes: "/><Run Text="complete adelanto, líquido y retención (se puede escribir o pegar desde Excel con Ctrl+V). Guarde."/></TextBlock>
                                <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"><Run FontWeight="Bold" Text="4. Horas del mes: "/><Run Text="complete horas comunes y extras por obra. Guarde. Use 'Revisar horas vs pagos' para ver diferencias."/></TextBlock>
                                <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"><Run FontWeight="Bold" Text="5. Reportes: "/><Run Text="genere los PDF. La distribución por obra se recalcula sola con los datos guardados."/></TextBlock>
                                <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"><Run FontWeight="Bold" Text="6. BPS por obra: "/><Run Text="cargue el total de cada factura del BPS y la tasa de la Sede, revise el reparto y descargue la planilla para cargar en SP."/></TextBlock>
                                <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"><Run FontWeight="Bold" Text="7. Cerrar el mes: "/><Run Text="en la pestaña Períodos, cuando todo esté pago. Queda protegido contra cambios."/></TextBlock>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#6B7280"
                                           Text="Colores en las tablas: rojo = error (no deja guardar) · amarillo = aviso · azul = cambio sin guardar. Celdas grises = se completan solas."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ PAGOS -->
            <TabItem Header="Pagos del mes">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="💾 Guardar pagos" Click="GuardarPagos_Click" IsEnabled="{Binding Pagos.PuedeEditar}" Style="{StaticResource BotonPrincipal}"/>
                        <Button Content="📄 Cargar planilla ábaco (PDF)" Command="{Binding CargarAbacoCommand}" IsEnabled="{Binding Pagos.PuedeEditar}" Style="{StaticResource BotonPrincipal}"
                                Background="#16324F" ToolTip="Lee la 'Planilla de Sueldos a Pagar' de ábaco (Construcción e Industria y Comercio) y completa adelanto, líquido y retención."/>
                        <Button Content="➕ Agregar fila" Click="AgregarPago_Click" IsEnabled="{Binding Pagos.PuedeEditar}" Style="{StaticResource BotonBarra}"/>
                        <Button Content="Eliminar filas seleccionadas" Click="EliminarPagos_Click" IsEnabled="{Binding Pagos.PuedeEditar}" Style="{StaticResource BotonBarra}"/>
                        <Button Content="Quitar filas sin montos" Command="{Binding QuitarPagosSinMontosCommand}" IsEnabled="{Binding Pagos.PuedeEditar}" Style="{StaticResource BotonBarra}"
                                ToolTip="Quita de la tabla las filas con adelanto, líquido y retención en 0 (se borran al guardar)."/>
                        <Button Content="🔎 Revisar horas vs pagos" Command="{Binding RevisarCrucesCommand}" Style="{StaticResource BotonBarra}"/>
                        <Button Content="Descartar cambios" Click="Descartar_Click" Style="{StaticResource BotonBarra}"/>
                        <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="12,0,6,8"/>
                        <TextBox Text="{Binding Pagos.Buscar, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,10,8" VerticalContentAlignment="Center"/>
                        <CheckBox Content="Solo filas con problemas" IsChecked="{Binding Pagos.SoloConProblemas}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <Border Grid.Row="1" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8"
                            Visibility="{Binding Pagos.SoloLectura, Converter={StaticResource BoolAVisible}}">
                        <TextBlock Text="Este período está cerrado: solo lectura. Para corregirlo, reábralo en la pestaña Períodos." TextWrapping="Wrap"/>
                    </Border>
                    <DataGrid Grid.Row="2" x:Name="dgPagos" Style="{StaticResource TablaCarga}" ItemsSource="{Binding Pagos.Vista}"
                              IsReadOnly="{Binding Pagos.SoloLectura}" CanUserAddRows="{Binding Pagos.PuedeEditar}" CanUserDeleteRows="{Binding Pagos.PuedeEditar}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N° Func." Binding="{Binding NumeroFuncionario}" Width="75"/>
                            <DataGridTextColumn Header="Funcionario" Binding="{Binding Nombre, Mode=OneWay}" Width="250" IsReadOnly="True" CellStyle="{StaticResource CeldaCalculada}"/>
                            <DataGridComboBoxColumn Header="Tipo de obra" Width="160" ItemsSource="{x:Static carga:OpcionesCarga.TiposObra}"
                                                    SelectedItemBinding="{Binding TipoObraTexto, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Adelanto" Binding="{Binding Adelanto, Converter={StaticResource Numero}, ValidatesOnExceptions=True}" Width="105" ElementStyle="{StaticResource CeldaNumero}"/>
                            <DataGridTextColumn Header="Líquido" Binding="{Binding Liquido, Converter={StaticResource Numero}, ValidatesOnExceptions=True}" Width="105" ElementStyle="{StaticResource CeldaNumero}"/>
                            <DataGridTextColumn Header="Retención" Binding="{Binding Retencion, Converter={StaticResource Numero}, ValidatesOnExceptions=True}" Width="105" ElementStyle="{StaticResource CeldaNumero}"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, Mode=OneWay, Converter={StaticResource Numero}}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource CeldaNumero}" CellStyle="{StaticResource CeldaCalculada}"/>
                            <DataGridTextColumn Header="Nominal ábaco" Binding="{Binding Nominal, Mode=OneWay, Converter={StaticResource Numero}}" Width="105" IsReadOnly="True" ElementStyle="{StaticResource CeldaNumero}" CellStyle="{StaticResource CeldaCalculada}"/>
                            <DataGridTextColumn Header="Pago por" Binding="{Binding TipoPago, Mode=OneWay}" Width="80" IsReadOnly="True" CellStyle="{StaticResource CeldaCalculada}"/>
                            <DataGridTextColumn Header="Observación" Binding="{Binding Observacion}" Width="110"/>
                            <DataGridTextColumn Header="Cliente (Adm.)" Binding="{Binding Cliente}" Width="110"/>
                            <DataGridTextColumn Header="Problema / aviso" Binding="{Binding Problema, Mode=OneWay}" Width="*" IsReadOnly="True" CellStyle="{StaticResource CeldaProblema}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Pagos.Totales}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding Pagos.Resumen}" Foreground="#475569"/>
                        <TextBlock Foreground="#6B7280" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Para pegar desde Excel: copie las columnas ADELANTO, LIQUIDO y RETENCION, haga clic en la celda Adelanto de la primera fila y presione Ctrl+V. La última fila en blanco sirve para agregar funcionarios."/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================ HORAS -->
            <TabItem Header="Horas del mes">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="💾 Guardar horas" Click="GuardarHoras_Click" IsEnabled="{Binding Horas.PuedeEditar}" Style="{StaticResource BotonPrincipal}"/>
                        <Button Content="📄 Cargar horas (Excel)" Command="{Binding CargarHorasCommand}" IsEnabled="{Binding Horas.PuedeEditar}" Style="{StaticResource BotonPrincipal}"
                                Background="#16324F" ToolTip="Lee el archivo DATOS SUELDO del mes y reemplaza las horas del mes en pantalla."/>
                        <Button Content="➕ Agregar fila" Click="AgregarHora_Click" IsEnabled="{Binding Horas.PuedeEditar}" Style="{StaticResource BotonBarra}"/>
                        <Button Content="Eliminar filas seleccionadas" Click="EliminarHoras_Click" IsEnabled="{Binding Horas.PuedeEditar}" Style="{StaticResource BotonBarra}"/>
                        <Button Content="Quitar filas sin horas" Command="{Binding QuitarHorasSinHorasCommand}" IsEnabled="{Binding Horas.PuedeEditar}" Style="{StaticResource BotonBarra}"/>
                        <Button Content="🔎 Revisar horas vs pagos" Command="{Binding RevisarCrucesCommand}" Style="{StaticResource BotonBarra}"/>
                        <Button Content="Descartar cambios" Click="Descartar_Click" Style="{StaticResource BotonBarra}"/>
                        <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="12,0,6,8"/>
                        <TextBox Text="{Binding Horas.Buscar, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,10,8" VerticalContentAlignment="Center"/>
                        <CheckBox Content="Solo filas con problemas" IsChecked="{Binding Horas.SoloConProblemas}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <Border Grid.Row="1" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8"
                            Visibility="{Binding Horas.SoloLectura, Converter={StaticResource BoolAVisible}}">
                        <TextBlock Text="Este período está cerrado: solo lectura. Para corregirlo, reábralo en la pestaña Períodos." TextWrapping="Wrap"/>
                    </Border>
                    <DataGrid Grid.Row="2" x:Name="dgHoras" Style="{StaticResource TablaCarga}" ItemsSource="{Binding Horas.Vista}"
                              IsReadOnly="{Binding Horas.SoloLectura}" CanUserAddRows="{Binding Horas.PuedeEditar}" CanUserDeleteRows="{Binding Horas.PuedeEditar}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N° Func." Binding="{Binding NumeroFuncionario}" Width="75"/>
                            <DataGridTextColumn Header="Funcionario" Binding="{Binding Nombre, Mode=OneWay}" Width="230" IsReadOnly="True" CellStyle="{StaticResource CeldaCalculada}"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria, Mode=OneWay}" Width="130" IsReadOnly="True" CellStyle="{StaticResource CeldaCalculada}"/>
                            <DataGridTextColumn Header="N° Obra" Binding="{Binding NumeroObra}" Width="75"/>
                            <DataGridTextColumn Header="Obra" Binding="{Binding NombreObra, Mode=OneWay}" Width="200" IsReadOnly="True" CellStyle="{StaticResource CeldaCalculada}"/>
                            <DataGridTextColumn Header="Tipo de obra" Binding="{Binding TipoObraTexto, Mode=OneWay}" Width="140" IsReadOnly="True" CellStyle="{StaticResource CeldaCalculada}"/>
                            <DataGridTextColumn Header="Hs. comunes" Binding="{Binding HorasComunes, Converter={StaticResource Numero}, ValidatesOnExceptions=True}" Width="95" ElementStyle="{StaticResource CeldaNumero}"/>
                            <DataGridTextColumn Header="Hs. extras" Binding="{Binding HorasExtras, Converter={StaticResource Numero}, ValidatesOnExceptions=True}" Width="95" ElementStyle="{StaticResource CeldaNumero}"/>
                            <DataGridTextColumn Header="Hs. lluvia" Binding="{Binding HorasLluvia, Converter={StaticResource Numero}, ValidatesOnExceptions=True}" Width="90" ElementStyle="{StaticResource CeldaNumero}"/>
                            <DataGridTextColumn Header="Hs. equivalentes" Binding="{Binding HorasEquivalentes, Mode=OneWay, Converter={StaticResource Numero}}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource CeldaNumero}" CellStyle="{StaticResource CeldaCalculada}"/>
                            <DataGridTextColumn Header="Problema / aviso" Binding="{Binding Problema, Mode=OneWay}" Width="*" IsReadOnly="True" CellStyle="{StaticResource CeldaProblema}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Horas.Totales}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding Horas.Resumen}" Foreground="#475569"/>
                        <TextBlock Foreground="#6B7280" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Horas equivalentes = comunes + 2 × extras + lluvia. Lo normal es '📄 Cargar horas (Excel)' con el archivo DATOS SUELDO del mes; también se puede escribir o pegar con Ctrl+V."/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================ FUNCIONARIOS -->
            <TabItem Header="Funcionarios">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="💾 Guardar funcionarios" Click="GuardarFuncionarios_Click" Style="{StaticResource BotonPrincipal}"/>
                        <Button Content="➕ Agregar funcionario" Click="AgregarFuncionario_Click" Style="{StaticResource BotonBarra}"/>
                        <Button Content="Quitar filas nuevas seleccionadas" Click="EliminarFuncionarios_Click" Style="{StaticResource BotonBarra}"/>
                        <Button Content="Descartar cambios" Click="Descartar_Click" Style="{StaticResource BotonBarra}"/>
                        <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="12,0,6,8"/>
                        <TextBox Text="{Binding FuncionariosEdicion.Buscar, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,10,8" VerticalContentAlignment="Center"/>
                        <CheckBox Content="Solo filas con problemas" IsChecked="{Binding FuncionariosEdicion.SoloConProblemas}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="1" x:Name="dgFuncionarios" Style="{StaticResource TablaCarga}" ItemsSource="{Binding FuncionariosEdicion.Vista}"
                              CanUserAddRows="True" CanUserDeleteRows="False" FrozenColumnCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Número" Binding="{Binding NumeroFuncionario}" Width="80">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell"><Setter Property="IsEnabled" Value="{Binding NumeroEditable}"/></Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="270"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="125"/>
                            <DataGridTextColumn Header="Tipo de pago" Binding="{Binding TipoPago}" Width="85"/>
                            <DataGridTextColumn Header="Banco" Binding="{Binding Banco}" Width="85"/>
                            <DataGridTextColumn Header="Cuenta nueva" Binding="{Binding CuentaNueva}" Width="125"/>
                            <DataGridTextColumn Header="Cuenta vieja" Binding="{Binding CuentaVieja}" Width="105"/>
                            <DataGridTextColumn Header="Resp. retención" Binding="{Binding ResponsableRetencion}" Width="125"/>
                            <DataGridTextColumn Header="Banco ret." Binding="{Binding BancoRetencion}" Width="80"/>
                            <DataGridTextColumn Header="Cuenta ret." Binding="{Binding CuentaRetencion}" Width="105"/>
                            <DataGridTextColumn Header="Ret. fija" Binding="{Binding RetencionFija, Converter={StaticResource Numero}, ValidatesOnExceptions=True}" Width="80" ElementStyle="{StaticResource CeldaNumero}"/>
                            <DataGridCheckBoxColumn Header="1 h SEDE" Binding="{Binding HoraFijaSede, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                            <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="Problema / aviso" Binding="{Binding Problema, Mode=OneWay}" Width="*" MinWidth="110" IsReadOnly="True" CellStyle="{StaticResource CeldaProblema}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="{Binding FuncionariosEdicion.Resumen}" Foreground="#475569"/>
                        <TextBlock Foreground="#6B7280" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="El número de un funcionario ya guardado no se cambia. Para dar de baja a alguien, destilde 'Activo' (no se borra porque tiene historia). Una misma persona puede tener un número por categoría."/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================ OBRAS -->
            <TabItem Header="Obras">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="💾 Guardar obras" Click="GuardarObras_Click" Style="{StaticResource BotonPrincipal}"/>
                        <Button Content="➕ Agregar obra" Click="AgregarObra_Click" Style="{StaticResource BotonBarra}"/>
                        <Button Content="Quitar filas nuevas seleccionadas" Click="EliminarObras_Click" Style="{StaticResource BotonBarra}"/>
                        <Button Content="Descartar cambios" Click="Descartar_Click" Style="{StaticResource BotonBarra}"/>
                        <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="12,0,6,8"/>
                        <TextBox Text="{Binding ObrasEdicion.Buscar, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,10,8" VerticalContentAlignment="Center"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="1" x:Name="dgObras" Style="{StaticResource TablaCarga}" ItemsSource="{Binding ObrasEdicion.Vista}"
                              CanUserAddRows="True" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Número" Binding="{Binding NumeroObra}" Width="80">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell"><Setter Property="IsEnabled" Value="{Binding NumeroEditable}"/></Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Obra" Binding="{Binding Nombre}" Width="320"/>
                            <DataGridComboBoxColumn Header="Tipo de obra" Width="170" ItemsSource="{x:Static carga:OpcionesCarga.TiposObra}"
                                                    SelectedItemBinding="{Binding TipoObraTexto, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="160"/>
                            <DataGridCheckBoxColumn Header="Activa" Binding="{Binding Activa, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="Problema / aviso" Binding="{Binding Problema, Mode=OneWay}" Width="*" IsReadOnly="True" CellStyle="{StaticResource CeldaProblema}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="{Binding ObrasEdicion.Resumen}" Foreground="#475569"/>
                        <TextBlock Foreground="#6B7280" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Los administrativos se cargan a la obra cuyo nombre contiene 'SEDE' de cada tipo. Para dar de baja una obra, destilde 'Activa'."/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================ REPORTES -->
            <TabItem Header="Reportes">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Vertical" Margin="0,0,0,12">
                        <TextBlock Text="Carpeta destino" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding CarpetaReportes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button Content="💵 PDFs de pagos (Retenciones, Consolidado, RedPagos, N-A)" Command="{Binding GenerarReportesSoloPagosCommand}" Style="{StaticResource BotonPrincipal}"
                                    ToolTip="Solo usa los pagos del mes. No necesita horas."/>
                            <Button Content="Todos los PDFs (incluye Adelantos y Distribución por obra)" Command="{Binding GenerarTodosLosReportesCommand}" Style="{StaticResource BotonBarra}"
                                    ToolTip="Revisa horas vs pagos, recalcula la distribución y genera los 6 PDF."/>
                            <Button Content="📊 Planilla Pagos (Excel)" Command="{Binding GenerarPlanillaPagosCommand}" Style="{StaticResource BotonBarra}"/>
                            <Button Content="📈 Porcentaje Horas (Excel)" Command="{Binding GenerarPorcentajeHorasCommand}" Style="{StaticResource BotonBarra}"/>
                            <Button Content="📂 Abrir carpeta" Click="AbrirCarpetaReportes_Click" Style="{StaticResource BotonBarra}"/>
                        </WrapPanel>
                    </StackPanel>
                    <DockPanel Grid.Row="1">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Left">
                            <Button Content="Eliminar seleccionados (PDF)" Padding="12,6" Click="EliminarReportes_Click"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding ReportesGenerados}" AutoGenerateColumns="False" IsReadOnly="True" x:Name="dgReportes" SelectionMode="Extended" SelectionUnit="FullRow"
                                  MouseDoubleClick="AbrirReporte_DoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Archivo (doble clic para abrir)" Binding="{Binding Codigo}" Width="300"/>
                                <DataGridTextColumn Header="Ruta" Binding="{Binding Descripcion}" Width="*"/>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Extra}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================ DISTRIBUCIÓN -->
            <TabItem Header="Distribución">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Calcular distribución" Command="{Binding CalcularDistribucionCommand}" Style="{StaticResource BotonPrincipal}"/>
                        <Button Content="Eliminar seleccionados (DB)" Click="EliminarDistribucion_Click" Style="{StaticResource BotonBarra}"/>
                        <TextBlock Text="Se recalcula sola al generar 'Todos los PDFs'. Si cambian horas o pagos, la distribución anterior se descarta." Foreground="#6B7280" VerticalAlignment="Center" Margin="8,0,0,8"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DistribucionLineas}" AutoGenerateColumns="False" IsReadOnly="True" x:Name="dgDistribucion" SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TipoObra}" Width="120"/>
                            <DataGridTextColumn Header="N° Obra" Binding="{Binding NumeroObra}" Width="100"/>
                            <DataGridTextColumn Header="Obra" Binding="{Binding NombreObra}" Width="220"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="180"/>
                            <DataGridTextColumn Header="Horas" Binding="{Binding HorasLinea, StringFormat={}{0:N2}}" Width="90"/>
                            <DataGridTextColumn Header="Jornales" Binding="{Binding Jornales, StringFormat={}{0:N2}}" Width="90"/>
                            <DataGridTextColumn Header="% Part." Binding="{Binding PorcentajeParticipacion, StringFormat={}{0:P2}}" Width="100"/>
                            <DataGridTextColumn Header="$ / Hora" Binding="{Binding ValorHora, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="Monto" Binding="{Binding MontoLinea, StringFormat={}{0:N2}}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ============================================================ BPS POR OBRA -->
            <TabItem Header="BPS por obra">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="💾 Guardar facturas" Command="{Binding GuardarBpsCommand}" IsEnabled="{Binding BpsPuedeEditar}" Style="{StaticResource BotonPrincipal}"/>
                        <Button Content="▶ Calcular reparto" Command="{Binding CalcularBpsCommand}" Style="{StaticResource BotonPrincipal}" Background="#16324F"/>
                        <Button Content="📊 Planilla para SP (Excel)" Command="{Binding PlanillaSpBpsCommand}" Style="{StaticResource BotonBarra}"
                                ToolTip="Arma el Excel con una factura BPS por obra, como se cargaba en SP. El programa no escribe en SP."/>
                        <TextBlock Foreground="#6B7280" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="700" Margin="8,0,0,8"
                                   Text="Cargue el total de cada factura del BPS tal cual se paga y la tasa de la Sede. El programa separa la Sede y reparte el resto entre las obras por sus horas equivalentes."/>
                    </WrapPanel>
                    <Border Grid.Row="1" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8"
                            Visibility="{Binding PeriodoCerrado, Converter={StaticResource BoolAVisible}}">
                        <TextBlock Text="Este período está cerrado: las facturas no se pueden cambiar. El reparto y la planilla para SP se pueden ver y generar igual." TextWrapping="Wrap"/>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="440"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Facturas del BPS del mes" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <WrapPanel>
                                        <Button Content="➕ Agregar factura" Command="{Binding AgregarFacturaBpsCommand}" IsEnabled="{Binding BpsPuedeEditar}" Style="{StaticResource BotonBarra}"/>
                                        <Button Content="Quitar la seleccionada" Command="{Binding QuitarFacturaBpsCommand}" IsEnabled="{Binding BpsPuedeEditar}" Style="{StaticResource BotonBarra}"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding BpsTotales}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <TextBlock Text="Tasa BPS de la Sede (%)" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBox Text="{Binding TasaSedeTexto, UpdateSourceTrigger=PropertyChanged}" Width="110" Height="28" VerticalContentAlignment="Center"
                                                 IsEnabled="{Binding BpsPuedeEditar}"/>
                                        <TextBlock Text="{Binding BpsTasaNota}" Foreground="#B45309" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="290"/>
                                    </StackPanel>
                                    <TextBlock Foreground="#6B7280" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="Es la suma, concepto por concepto de la factura de IyC, de descuento ÷ monto gravado (39,656 % en 2025). BPS de la Sede = nominal de ábaco de cada administrativo × tasa."/>
                                    <TextBlock Foreground="#6B7280" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="Un importe vacío queda pendiente: no se toma como cero y no se reparte nada hasta completarlo o quitar la factura."/>
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding FacturasBps}" SelectedItem="{Binding FacturaBpsSeleccionada}" Style="{StaticResource TablaCarga}" RowStyle="{x:Null}"
                                          IsReadOnly="{Binding PeriodoCerrado}" CanUserAddRows="False" CanUserDeleteRows="False">
                                    <DataGrid.Columns>
                                        <DataGridComboBoxColumn Header="Empresa" Width="150" ItemsSource="{x:Static carga:OpcionesBps.Empresas}"
                                                                SelectedItemBinding="{Binding Empresa, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="Factura" Binding="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        <DataGridTextColumn Header="Importe" Binding="{Binding Importe, Converter={StaticResource Numero}, ValidatesOnExceptions=True}" Width="110" ElementStyle="{StaticResource CeldaNumero}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                <TextBlock Text="{Binding BpsResumen}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="22"/>
                            </Border>
                            <Border Grid.Row="1" Background="#FEE2E2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8"
                                    Visibility="{Binding BpsHayProblemas, Converter={StaticResource BoolAVisible}}">
                                <StackPanel>
                                    <TextBlock Text="Para resolver antes de repartir" FontWeight="Bold" Foreground="#7F1D1D" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding BpsProblemas}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" Foreground="#7F1D1D" TextWrapping="Wrap" Margin="0,1"/></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Background="#FEF9C3" BorderBrush="#EAB308" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8"
                                    Visibility="{Binding BpsHayAvisos, Converter={StaticResource BoolAVisible}}">
                                <ItemsControl ItemsSource="{Binding BpsAvisos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" Foreground="#713F12" TextWrapping="Wrap" Margin="0,1"/></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TabControl Grid.Row="3">
                                <TabItem Header="Reparto por obra">
                                    <DataGrid ItemsSource="{Binding BpsLineas}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="130"/>
                                            <DataGridTextColumn Header="N° Obra" Binding="{Binding NumeroObra}" Width="80"/>
                                            <DataGridTextColumn Header="Obra" Binding="{Binding NombreObra}" Width="*"/>
                                            <DataGridTextColumn Header="Horas equiv." Binding="{Binding Horas, StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource CeldaNumero}"/>
                                            <DataGridTextColumn Header="% de su tipo" Binding="{Binding Porcentaje, StringFormat={}{0:P2}}" Width="100" ElementStyle="{StaticResource CeldaNumero}"/>
                                            <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat={}{0:N2}}" Width="120" ElementStyle="{StaticResource CeldaNumero}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="Facturas para SP">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Bottom" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Text="Como se cargaba el BPS en SP hasta octubre de 2025: proveedor BPS, a crédito sin IVA, una factura por obra con Construcción e IyC sumados, insumo BPS × 1, imputada a la obra sin remito. La Sede va al depósito GASTOS2. Antes de cargar, revise que el mes no esté ya cargado en SP."/>
                                        <DataGrid ItemsSource="{Binding BpsFacturasSp}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="120"/>
                                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy}}" Width="90"/>
                                                <DataGridTextColumn Header="Imputada a" Binding="{Binding Destino}" Width="190"/>
                                                <DataGridTextColumn Header="Obra" Binding="{Binding Observacion}" Width="*"/>
                                                <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat={}{0:N2}}" Width="120" ElementStyle="{StaticResource CeldaNumero}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="Sede">
                                    <DataGrid ItemsSource="{Binding BpsSede}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="N° Func." Binding="{Binding NumeroFuncionario}" Width="80"/>
                                            <DataGridTextColumn Header="Funcionario" Binding="{Binding Nombre}" Width="*"/>
                                            <DataGridTextColumn Header="Nominal ábaco" Binding="{Binding Nominal, StringFormat={}{0:N2}}" Width="120" ElementStyle="{StaticResource CeldaNumero}"/>
                                            <DataGridTextColumn Header="BPS" Binding="{Binding Bps, StringFormat={}{0:N2}}" Width="120" ElementStyle="{StaticResource CeldaNumero}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================================================ PERÍODOS -->
            <TabItem Header="Períodos">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                        <TextBlock TextWrapping="Wrap" Foreground="#374151"
                                   Text="Cada mes se crea con '➕ Nuevo mes'. Cuando el mes está terminado (sueldos pagados y reportes emitidos), ciérrelo: queda protegido y no se pueden cambiar sus horas, pagos ni distribución. Si hay que corregir algo, reábralo. Ver otro período no cambia su estado."/>
                    </Border>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button Content="🔒 Cerrar el período en pantalla" Command="{Binding CerrarPeriodoCommand}" Style="{StaticResource BotonBarra}"/>
                        <Button Content="🔓 Reabrir el período en pantalla" Command="{Binding ReabrirPeriodoCommand}" Style="{StaticResource BotonBarra}"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Periodos}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Periodo" Binding="{Binding Codigo}" Width="120"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Descripcion}" Width="140"/>
                            <DataGridTextColumn Header="Fecha cierre / estado" Binding="{Binding Extra}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ============================================================ IMPORTAR (RESPALDO) -->
            <TabItem Header="Importar Excel (respaldo)">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                        <TextBlock TextWrapping="Wrap"
                                   Text="El trabajo normal se hace en las pestañas Pagos del mes, Horas del mes, Funcionarios y Obras. Importar una planilla REEMPLAZA las horas o pagos del período en pantalla; antes de importar se muestra una revisión de la planilla."/>
                    </Border>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                        <Button Content="Importar Funcionarios" Command="{Binding ImportarFuncionariosCommand}" Style="{StaticResource BotonBarra}"/>
                        <Button Content="Importar Obras" Command="{Binding ImportarObrasCommand}" Style="{StaticResource BotonBarra}"/>
                        <Button Content="Importar Horas" Command="{Binding ImportarHorasCommand}" Style="{StaticResource BotonBarra}"/>
                        <Button Content="Importar Pagos" Command="{Binding ImportarPagosCommand}" Style="{StaticResource BotonBarra}"/>
                        <Button Content="Vaciar Auditoría e Incidencias" Click="ClearAuditIncidents_Click" Style="{StaticResource BotonBarra}"/>
                    </WrapPanel>
                    <GroupBox Header="Auditoría reciente" Grid.Row="2" Margin="0,0,0,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Left">
                                <Button Content="Eliminar seleccionados (Auditoría)" Padding="12,6" Click="EliminarAuditoria_Click"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Auditoria}" AutoGenerateColumns="False" IsReadOnly="True" x:Name="dgAuditoria" SelectionMode="Extended" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Codigo}" Width="140"/>
                                    <DataGridTextColumn Header="Acción" Binding="{Binding Descripcion}" Width="220"/>
                                    <DataGridTextColumn Header="Detalle" Binding="{Binding Extra}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                    <GroupBox Header="Incidencias de importación" Grid.Row="3">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Left">
                                <Button Content="Eliminar seleccionados (Incidencias)" Padding="12,6" Click="EliminarIncidencias_Click"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Incidencias}" AutoGenerateColumns="False" IsReadOnly="True" x:Name="dgIncidencias" SelectionMode="Extended" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Codigo}" Width="120"/>
                                    <DataGridTextColumn Header="Referencia" Binding="{Binding Descripcion}" Width="180"/>
                                    <DataGridTextColumn Header="Descripción" Binding="{Binding Extra}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="🗑 Borrar TODOS los datos" Padding="12,6" Click="ResetearTodosDatos_Click" Foreground="White" Background="#DC2626" FontWeight="SemiBold"
                                ToolTip="Borra funcionarios, obras, horas, pagos y períodos. Antes guarda una copia de la base."/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1,1,0,0" Padding="10">
            <TextBlock Text="{Binding Status}" Foreground="#374151"/>
        </Border>
    </Grid>
</Window>
